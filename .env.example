# ── Banco de dados ─────────────────────────────────────────────────
# Local (docker-compose): usa o serviço "postgres"
DATABASE_URL=postgresql://videoteca:TROQUE_ESTA_SENHA@postgres:5432/videoteca
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA
# Temporário (Supabase): descomente e use a connection string do projeto
# DATABASE_URL=postgresql://postgres:SUA_SENHA@db.<ref>.supabase.co:5432/postgres

# ── API ────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=troque-este-segredo-em-producao
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── Segurança / operação (sprints 6–7) ─────────────────────────────
# production: exige JWT_SECRET forte (≥32 chars), CORS sem "*", liga HSTS
ENVIRONMENT=development
EXPOSE_DOCS=true
# Métricas CloudWatch em Embedded Metric Format (ligado automaticamente fora de development)
EMF_ENABLED=0
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=300
