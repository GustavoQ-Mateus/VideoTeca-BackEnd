{
  "resource": {
    "aws_s3_bucket": {
      "reports": {
        "count": "${var.enabled ? 1 : 0}",
        "bucket_prefix": "${var.name}-reports-"
      }
    },
    "aws_s3_bucket_public_access_block": {
      "reports": {
        "count": "${var.enabled ? 1 : 0}",
        "bucket": "${aws_s3_bucket.reports[0].id}",
        "block_public_acls": true,
        "block_public_policy": true,
        "ignore_public_acls": true,
        "restrict_public_buckets": true
      }
    },
    "aws_s3_bucket_server_side_encryption_configuration": {
      "reports": {
        "count": "${var.enabled ? 1 : 0}",
        "bucket": "${aws_s3_bucket.reports[0].id}",
        "rule": {
          "apply_server_side_encryption_by_default": {
            "sse_algorithm": "AES256"
          }
        }
      }
    },
    "aws_s3_bucket_policy": {
      "reports_tls": {
        "count": "${var.enabled ? 1 : 0}",
        "bucket": "${aws_s3_bucket.reports[0].id}",
        "policy": "${jsonencode({Version=\"2012-10-17\",Statement=[{Effect=\"Deny\",Principal=\"*\",Action=\"s3:*\",Resource=[aws_s3_bucket.reports[0].arn,\"${aws_s3_bucket.reports[0].arn}/*\"],Condition={Bool={\"aws:SecureTransport\"=\"false\"}}}]})}"
      }
    },
    "aws_iam_role": {
      "reports": {
        "count": "${var.enabled ? 1 : 0}",
        "name_prefix": "${var.name}-reports-",
        "assume_role_policy": "{\"Version\": \"2012-10-17\", \"Statement\": [{\"Effect\": \"Allow\", \"Principal\": {\"Service\": \"ecs-tasks.amazonaws.com\"}, \"Action\": \"sts:AssumeRole\"}]}"
      }
    },
    "aws_iam_role_policy": {
      "reports": {
        "count": "${var.enabled ? 1 : 0}",
        "role": "${aws_iam_role.reports[0].id}",
        "policy": "${jsonencode({Version=\"2012-10-17\",Statement=[{Effect=\"Allow\",Action=[\"s3:PutObject\"],Resource=[\"${aws_s3_bucket.reports[0].arn}/exports/*\"]}]})}"
      }
    },
    "aws_batch_job_definition": {
      "reports": {
        "count": "${var.enabled ? 1 : 0}",
        "name": "${var.name}-reports",
        "type": "container",
        "platform_capabilities": [
          "FARGATE"
        ],
        "container_properties": "${jsonencode({\"image\": \"${var.reports_image}\", \"command\": \"${var.reports_command}\", \"executionRoleArn\": \"${aws_iam_role.execution[0].arn}\", \"jobRoleArn\": \"${aws_iam_role.reports[0].arn}\", \"resourceRequirements\": [{\"type\": \"VCPU\", \"value\": \"0.25\"}, {\"type\": \"MEMORY\", \"value\": \"512\"}], \"networkConfiguration\": {\"assignPublicIp\": \"DISABLED\"}, \"fargatePlatformConfiguration\": {\"platformVersion\": \"LATEST\"}, \"secrets\": [{\"name\": \"DATABASE_URL\", \"valueFrom\": \"${var.database_secret_arn}\"}], \"environment\": [{\"name\": \"REPORTS_BUCKET\", \"value\": \"${aws_s3_bucket.reports[0].id}\"}, {\"name\": \"REPORTS_PREFIX\", \"value\": \"exports/\"}], \"logConfiguration\": {\"logDriver\": \"awslogs\", \"options\": {\"awslogs-group\": \"${aws_cloudwatch_log_group.jobs[0].name}\", \"awslogs-region\": \"${var.region}\", \"awslogs-stream-prefix\": \"reports\"}}})}",
        "retry_strategy": {
          "attempts": 3
        },
        "timeout": {
          "attempt_duration_seconds": 900
        }
      }
    }
  },
  "output": {
    "reports_job_definition_arn": {
      "value": "${try(aws_batch_job_definition.reports[0].arn,null)}"
    },
    "reports_bucket": {
      "value": "${try(aws_s3_bucket.reports[0].id,null)}"
    }
  }
}
