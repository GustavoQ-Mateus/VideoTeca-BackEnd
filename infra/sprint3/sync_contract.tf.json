{
  "resource": {
    "aws_sqs_queue": {
      "sync_dlq": {
        "count": "${var.enabled ? 1 : 0}",
        "name": "${var.name}-sync-dlq",
        "sqs_managed_sse_enabled": true,
        "message_retention_seconds": 1209600
      },
      "sync": {
        "count": "${var.enabled ? 1 : 0}",
        "name": "${var.name}-sync",
        "sqs_managed_sse_enabled": true,
        "visibility_timeout_seconds": 300,
        "receive_wait_time_seconds": 20,
        "redrive_policy": "${jsonencode({deadLetterTargetArn=aws_sqs_queue.sync_dlq[0].arn,maxReceiveCount=5})}"
      }
    },
    "aws_sqs_queue_redrive_allow_policy": {
      "sync": {
        "count": "${var.enabled ? 1 : 0}",
        "queue_url": "${aws_sqs_queue.sync_dlq[0].id}",
        "redrive_allow_policy": "${jsonencode({redrivePermission=\"byQueue\",sourceQueueArns=[aws_sqs_queue.sync[0].arn]})}"
      }
    },
    "aws_iam_role_policy": {
      "worker_queue": {
        "count": "${var.enabled ? 1 : 0}",
        "role": "${aws_iam_role.worker[0].id}",
        "policy": "${jsonencode({Version=\"2012-10-17\",Statement=[{Effect=\"Allow\",Action=[\"sqs:ReceiveMessage\",\"sqs:DeleteMessage\",\"sqs:ChangeMessageVisibility\",\"sqs:GetQueueAttributes\"],Resource=[aws_sqs_queue.sync[0].arn]}]})}"
      }
    }
  },
  "output": {
    "sync_queue_arn": {
      "value": "${try(aws_sqs_queue.sync[0].arn,null)}"
    }
  }
}
